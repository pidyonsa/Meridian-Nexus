{
  "functions": [{"source":"backend","codebase":"public-dashboard-viewer","runtime":"nodejs22","ignore":["node_modules",".git","firebase-debug.log"]}],
  "hosting": {
    "site":"meridian-field-dashboards",
    "public":"dist",
    "ignore":["**/.*","**/node_modules/**"],
    "headers":[{"source":"**","headers":[
      {"key":"Cache-Control","value":"no-cache"},
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"X-Frame-Options","value":"DENY"},
      {"key":"Referrer-Policy","value":"no-referrer"},
      {"key":"X-Robots-Tag","value":"noindex, nofollow, noarchive"},
      {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"}
    ]}],
    "rewrites":[
      {"source":"/api/**","function":{"functionId":"publicMeridianDashboards","region":"us-central1"}},
      {"source":"/attendance{,/**}","destination":"/index.html"},
      {"source":"/franchise-orders{,/**}","destination":"/index.html"},
      {"source":"/","destination":"/index.html"}
    ]
  }
}
